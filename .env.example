# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted (e.g. https://your-brand.vercel.app).
APP_URL=""

# VITE_API_BASE: Custom API base URL (Default: '/api' for same-origin Vercel deployment)
# VITE_API_BASE="/api"

# SESSION_SECRET: Secret key for signing server-side auth sessions (Optional)
SESSION_SECRET="sh-collection-luxury-bridal-secret-2026"

# =========================================================================
# PRODUCTION MEDIA STORAGE (Vercel Serverless Production-Safe)
# =========================================================================
# Recommended for Vercel: Cloudinary (Permanent CDN for images & HD fashion videos)
# Option A: Single Cloudinary URL:
# CLOUDINARY_URL="cloudinary://<api_key>:<api_secret>@<cloud_name>"
#
# Option B: Individual credentials:
# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""
#
# NOTE: If no cloud credentials are set, the app falls back to local /uploads
# for zero-config local development and rapid prototyping.

# PORT: Local server port (Default: 3000 for local dev server, ignored on Vercel Serverless)
PORT=3000

# DISABLE_HMR: Set to 'true' in preview iframe environments to disable HMR WebSocket
# DISABLE_HMR=false
